# Render runtime (server-only)
# Use the least-privilege pooled Neon URL here.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=
CRON_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development

# Local migration commands only. Never deploy this direct owner URL.
DATABASE_URL_UNPOOLED=

# Vercel frontend and same-origin proxy
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=ws://127.0.0.1:8787/api/v1/realtime
RENDER_API_BASE_URL=http://127.0.0.1:8787
VITE_SITE_URL=http://localhost:5173

# Optional ambience-only audition control
VITE_ENABLE_AMBIENCE_SOLO_PREVIEW=
