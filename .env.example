# ─── Supabase Configuration ─────────────────────────────────────
# Server-side (SSR / Server Functions) — never exposed to browser
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_SECRET_KEY=your-supabase-secret-key
CRON_SECRET=replace-with-a-long-random-production-secret

# Neon runtime uses the pooled hostname containing "-pooler".
DATABASE_URL=
# Migrations, dumps, and restores use the direct hostname without "-pooler".
DATABASE_URL_UNPOOLED=
# Public reads default to Supabase when omitted. Set to "neon" for Neon reads.
DATA_BACKEND=supabase
# Operational writes default to Supabase independently of public reads.
OPERATIONAL_WRITE_BACKEND=supabase
# Administrator authorization defaults to Supabase independently of data routing.
ADMIN_AUTHORIZATION_BACKEND=supabase
# Administrator reads and transactions default to Supabase independently.
ADMIN_DATA_BACKEND=supabase

# Client-side (Vite inlines VITE_* variables at build time)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# Optional - expose the ambience-only audition control in non-production review builds
VITE_ENABLE_AMBIENCE_SOLO_PREVIEW=

# Optional - Canonical website URL for Open Graph link sharing previews (e.g. https://sainikdhaba.com)
VITE_SITE_URL=
